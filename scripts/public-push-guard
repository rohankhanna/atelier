#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

deny_paths_regex='(^|/)(AGENTS\.md|CLAUDE\.md|GEMINI\.md|HERMES\.md|PROJECT_INTENT\.md|PUBLIC_PRIVATE_BOUNDARY\.md|AUTHORSHIP\.md|AGENTS\.md\.sha256|\.hot-reload\.watch|CHUG_PROMPT\.md|PIECRUST\.json)$|(^|/)(internal|logs|feedback|learnings|\.claude|\.gemini|\.agents|\.codex|\.aws|\.githooks)(/|$)|^scripts/(polestar|piecrust)_check_prior_art_gate\.sh$|^last$'
deny_terms_regex='Overarch|callosum|Callosum|Relay|Hermes|PROJECT_INTENT|AGENTS|prior-art|vault_path|rohankhanna'
public_scan_paths=(README.md docs src tests deploy)

reject() {
  printf 'public-push-guard: %s\n' "$*" >&2
  exit 1
}

is_zero_sha() {
  case "$1" in
    0000000000000000000000000000000000000000) return 0 ;;
    *) return 1 ;;
  esac
}

validate_public_tree() {
  local sha="$1"
  local denied_paths
  local path

  denied_paths="$(git ls-tree -r --name-only "$sha" | grep -E "$deny_paths_regex" || true)"
  if [ -n "$denied_paths" ]; then
    printf '%s\n' "$denied_paths" >&2
    reject "internal-only paths are present in the public tree"
  fi

  for path in "${public_scan_paths[@]}"; do
    if git cat-file -e "$sha:$path" 2>/dev/null; then
      if git grep -n -E "$deny_terms_regex" "$sha" -- "$path" >/tmp/atelier-public-push-guard.matches; then
        cat /tmp/atelier-public-push-guard.matches >&2
        reject "internal-only terms are present in public-facing files"
      fi
    fi
  done
}

if [ "$remote_name" != "public" ]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if is_zero_sha "$local_sha"; then
    continue
  fi

  if [ "$local_ref" != "refs/heads/main" ] || [ "$remote_ref" != "refs/heads/main" ]; then
    reject "only refs/heads/main may be pushed to public; got ${local_ref} -> ${remote_ref}"
  fi

  validate_public_tree "$local_sha"
done

printf 'public-push-guard: public push checks passed for %s\n' "$remote_url" >&2
